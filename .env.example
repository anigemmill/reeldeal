# Copy to .env.local for local development. Never commit real values.
# All variables are validated by src/env/schema.ts (npm run validate:env, also run before every build).

# --- Public (inlined into browser code; never put secrets here) ---
NEXT_PUBLIC_SITE_URL=
# Supabase (Phase 3). Set both or neither. The anon key is public by design; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never exposed to the browser) ---
# Show /design-system and the sample-data app routes in a production build.
REELDEAL_DESIGN_REVIEW=0
# Bypasses Row Level Security: background jobs only.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2, private bucket (Phase 3). Set all four or none.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Signed URL lifetime in seconds (30–3600, default 300).
R2_SIGNED_URL_TTL_SECONDS=300

# --- Platform and MCP server (server only) ---
# Postgres connection (Supabase in production, use the pooler with a role that RLS applies to).
# Leave empty locally to use the embedded database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# HMAC key for credit quotes and local signed URLs. 32+ random characters. Required in production.
SIGNING_SECRET=
# Personal access token used by the STDIO server (npm run dev:setup or npm run mcp:token).
REELDEAL_MCP_TOKEN=
# Remote MCP: the public URL of the /api/mcp endpoint (OAuth audience and resource metadata).
MCP_PUBLIC_URL=
# Comma-separated browser origins allowed to call the endpoint (non-browser clients send no Origin).
MCP_ALLOWED_ORIGINS=
MCP_HTTP_PORT=3333
MCP_LOG_LEVEL=info
# OAuth 2.1 via the Supabase Auth OAuth server. Set both to accept OAuth access tokens.
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
# AI provider. Without a key the AI tools are hidden and report "not configured".
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
# Storage: r2 (default when R2_BUCKET is set) or local (development; production needs explicit opt-in).
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=.data/storage
LOCAL_MEDIA_BASE_URL=
# Video tools (must be on PATH or set here).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Throwaway Postgres for npm run test:postgres (set automatically by that script).
TEST_DATABASE_URL=
