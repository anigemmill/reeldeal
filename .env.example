# Copy to .env.local for local development. Never commit real values.
# All variables are validated by src/env/schema.ts (npm run validate:env, also run before every build).

# --- Public (inlined into browser code; never put secrets here) ---
NEXT_PUBLIC_SITE_URL=
# Supabase (Phase 3). Set both or neither. The anon key is public by design; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never exposed to the browser) ---
# Show /design-system and the sample-data app routes in a production build.
REELDEAL_DESIGN_REVIEW=0
# Bypasses Row Level Security: background jobs only.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2, private bucket (Phase 3). Set all four or none.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Signed URL lifetime in seconds (30–3600, default 300).
R2_SIGNED_URL_TTL_SECONDS=300
