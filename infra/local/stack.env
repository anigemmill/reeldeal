# LOCAL ONLY: points the platform at infra/local/docker-compose.yml (npm run stack:up).
# Throwaway values that only work against the local containers. Never reuse them.
DATABASE_URL=postgres://postgres:local-dev-only-password@127.0.0.1:54322/postgres
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=localdevaccesskey
R2_SECRET_ACCESS_KEY=local-dev-only-secret-key
R2_BUCKET=reeldeal-media
R2_ENDPOINT=http://127.0.0.1:9000
SIGNING_SECRET=local-dev-only-signing-secret-0123456789
WORKER_STALE_SECONDS=20
INTEGRATION_USER_A_EMAIL=integration-a@reeldeal.local
INTEGRATION_USER_A_PASSWORD=local-dev-only-password-a
INTEGRATION_USER_B_EMAIL=integration-b@reeldeal.local
INTEGRATION_USER_B_PASSWORD=local-dev-only-password-b
