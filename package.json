{
  "name": "reeldeal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate:pricing": "tsx scripts/validate-pricing.ts",
    "prebuild": "npm run validate:pricing && npm run validate:env",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run validate:pricing && npm run validate:env && npm run check:tokens && npm run check:secrets && npm run check:migrations && npm run typecheck && npm run lint && npm run test",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "test:a11y": "tsx scripts/a11y.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "dev:setup": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/dev-setup.ts",
    "mcp:stdio": "scripts/mcp-stdio.sh",
    "mcp:http": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/mcp/http-server.ts",
    "mcp:token": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/mcp-token.ts",
    "worker": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/worker.ts",
    "db:local": "scripts/db-local.sh",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/db-migrate.ts",
    "mcp:smoke": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/mcp-smoke.ts",
    "test:postgres": "TEST_DATABASE_URL=$(scripts/db-local.sh start) vitest run src/server src/mcp",
    "stack:up": "docker compose -f infra/local/docker-compose.yml up -d --wait",
    "stack:down": "docker compose -f infra/local/docker-compose.yml down",
    "test:storage": "TEST_S3_ENDPOINT=${TEST_S3_ENDPOINT:-http://127.0.0.1:9000} vitest run src/server/storage",
    "test:supabase-local": "TEST_DATABASE_URL=postgres://postgres:local-dev-only-password@127.0.0.1:54322/postgres vitest run src/server src/mcp",
    "workspace:bootstrap": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/workspace-bootstrap.ts",
    "check:migrations": "node --import tsx scripts/check-migrations.ts",
    "integration:live": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/integration-live.ts",
    "worker:restart-test": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/worker-restart-test.ts",
    "infra:check": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/infra-check.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "review:shots": "tsx scripts/review-shots.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
